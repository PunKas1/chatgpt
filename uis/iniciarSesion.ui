      <string notr="true">/* Fondo general de la ventana */
#Form {
    background-color: rgb(2, 34, 5);
}

/* Tarjeta central con bordes redondos y borde sutil */
#card_login {
    background-color: rgb(39, 39, 39);
    border: 1px solid #27272a;
    border-radius: 16px;
    padding: 24px;
}

/* Estilo base para cualquier QLabel nuevo (evita texto negro invisible) */
QLabel {
    color: #ffffff;
    font-family: &quot;Segoe UI&quot;;
    font-size: 14px;
}

/* Título principal */
#label_4 {
    color: #ffffff;
    font-family: &quot;Comic Sans MS&quot;;
    font-size: 35px; 
    font-weight: bold;
}

#label_7{
	color: rgb(13, 104, 223);
    font-family: &quot;Comic Sans MS&quot;;
    font-size: 25px; 
    font-weight: bold;
}

/* Etiquetas de campos (con el guion bajo que asigna Qt Designer) */
#label_2, #label_3, #label_5, #label_6{
    color: #ffffff;
    font-family: &quot;Comic Sans MS&quot;;
    font-size: 16px;
    font-weight: normal;
}
QLineEdit {
    background-color: rgb(29, 29, 29);
    color: rgb(255, 255, 255);
    font-family: &quot;Comic Sans MS&quot;;
    font-size: 10px;
    border: 1px solid rgb(60, 60, 60);
    border-radius: 6px;
    padding: 4px 8px;
}


#bton_login {
    background-color: #ffffff;
    color: #09090b;
    border: none;
    border-radius: 8px;
    padding: 10px 18px;
    font-family: &quot;Segoe UI&quot;;
    font-size: 13px;
    font-weight: bold;
}

#bton_login:hover {
    background-color: #e4e4e7;
}

/* Botón secundario oscuro con borde */
#bton_crear {
    background-color: #1e1e22;
    color: #ffffff;
    border: 1px solid #3f3f46;
    border-radius: 8px;
    padding: 10px 18px;
    font-family: &quot;Segoe UI&quot;;
    font-size: 13px;
    font-weight: bold;
}

#bton_crear:hover {
    background-color: #27272a;
}</string>
